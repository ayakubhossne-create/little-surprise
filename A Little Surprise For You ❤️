@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; min-height: 100vh; background: linear-gradient(135deg, rgb(255, 214, 232), rgb(255, 245, 250), rgb(255, 197, 223)); font-family: Arial, sans-serif; display: flex; align-items: center; justify-content: center; overflow-x: hidden; padding: 25px 0px; }

.card { width: 90%; max-width: 390px; background: rgba(255, 255, 255, 0.93); padding: 30px 22px; border-radius: 25px; text-align: center; box-shadow: rgba(214, 91, 147, 0.376) 0px 10px 40px; position: relative; z-index: 2; }

.flower { font-size: 65px; animation: 2s ease 0s infinite normal none running float; }

h1 { color: rgb(229, 43, 120); font-size: 27px; }

p { color: rgb(113, 71, 91); font-size: 16px; line-height: 2; }

button { border: 0px; border-radius: 30px; background: rgb(229, 43, 120); color: white; padding: 14px 25px; font-size: 16px; font-weight: bold; margin-top: 15px; }

#letter { display: none; animation: 1.2s ease 0s 1 normal none running show; }

.heart { position: fixed; bottom: -30px; animation: 7s linear 0s infinite normal none running rise; z-index: 1; pointer-events: none; }

@keyframes float { 
  50% { transform: translateY(-12px); }
}

@keyframes show { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes rise { 
  100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
}
